# ==============================================================================
# QuickBooks Online API Configuration (Sandbox)
# ==============================================================================
# Get these credentials from your Intuit Developer Portal (https://developer.intuit.com)
# under your App Dashboard -> Keys & OAuth -> Sandbox Keys.
QBO_CLIENT_ID=your_quickbooks_client_id_here
QBO_CLIENT_SECRET=your_quickbooks_client_secret_here
QBO_REDIRECT_URI=http://localhost:8000/callback
QBO_ENVIRONMENT=sandbox
# Company ID (realmId) will be automatically detected during OAuth callback, or can be set manually:
QBO_REALM_ID=your_quickbooks_sandbox_realm_id_here

# ==============================================================================
# Google Cloud Platform & BigQuery Configuration
# ==============================================================================
# Application Default Credentials (ADC) will be used automatically.
# Run `gcloud auth application-default login` on your machine before running sync.
GCP_PROJECT_ID=stone-column-511709-d4
BIGQUERY_DATASET=quickbooks_data
BIGQUERY_LOCATION=US

# ==============================================================================
# Application & Sync Settings
# ==============================================================================
API_HOST=0.0.0.0
API_PORT=8000
SYNC_INTERVAL_HOURS=4
LOG_LEVEL=INFO
